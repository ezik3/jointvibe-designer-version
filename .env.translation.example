# Translation System Configuration
# Copy to .env.local and fill in your API keys

# ============================================
# TRANSLATION SERVICES
# ============================================

# Google Cloud Translation API
# https://cloud.google.com/translate
NEXT_PUBLIC_GOOGLE_TRANSLATE_ENABLED=true
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_api_key_here
GOOGLE_TRANSLATE_PROJECT_ID=your_project_id_here

# DeepL API
# https://www.deepl.com/pro-api
NEXT_PUBLIC_DEEPL_ENABLED=false
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_API_URL=https://api.deepl.com/v2

# Microsoft Azure Translator
# https://azure.microsoft.com/services/cognitive-services/translator/
NEXT_PUBLIC_AZURE_TRANSLATOR_ENABLED=false
AZURE_TRANSLATOR_KEY=your_azure_key_here
AZURE_TRANSLATOR_REGION=your_azure_region_here

# LibreTranslate (Self-hosted)
# https://libretranslate.com/
NEXT_PUBLIC_LIBRETRANSLATE_ENABLED=false
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=your_libretranslate_key_here

# ============================================
# TRANSLATION SYSTEM SETTINGS
# ============================================

# Enable/disable translation system
NEXT_PUBLIC_ENABLE_TRANSLATION=true

# Default behavior
NEXT_PUBLIC_AUTO_TRANSLATE_POSTS=true
NEXT_PUBLIC_AUTO_TRANSLATE_MESSAGES=true
NEXT_PUBLIC_AUTO_TRANSLATE_VENUES=false

# Cache settings
NEXT_PUBLIC_TRANSLATION_CACHE_ENABLED=true
NEXT_PUBLIC_TRANSLATION_CACHE_TTL_MINUTES=1440  # 24 hours
NEXT_PUBLIC_MEMORY_CACHE_SIZE=1000

# Rate limiting
NEXT_PUBLIC_MAX_REQUESTS_PER_MINUTE=60
NEXT_PUBLIC_BATCH_SIZE=10

# Fallback behavior
NEXT_PUBLIC_FALLBACK_TO_ENGLISH=true
NEXT_PUBLIC_FALLBACK_TO_ORIGINAL=true

# Quality settings
NEXT_PUBLIC_MIN_CONFIDENCE_THRESHOLD=0.3
NEXT_PUBLIC_RETRY_FAILED_TRANSLATIONS=true
NEXT_PUBLIC_MAX_RETRY_ATTEMPTS=3

# ============================================
# LANGUAGE DETECTION
# ============================================

# Language detection service
NEXT_PUBLIC_LANGUAGE_DETECTION_ENABLED=true
NEXT_PUBLIC_LANGUAGE_DETECTION_CONFIDENCE=0.5

# Supported languages (comma-separated)
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ru,ja,ko,zh,ar,hi

# Priority languages for auto-translation
NEXT_PUBLIC_PRIORITY_LANGUAGES=en,es

# ============================================
# AI INTEGRATION
# ============================================

# AI translation settings
NEXT_PUBLIC_AI_TRANSLATION_ENABLED=true
NEXT_PUBLIC_AI_CONTEXT_WINDOW=10
NEXT_PUBLIC_AI_PRESERVE_ORIGINAL=true

# ============================================
# MONITORING & LOGGING
# ============================================

# Enable translation logging
NEXT_PUBLIC_LOG_TRANSLATIONS=true
NEXT_PUBLIC_LOG_LEVEL=info  # debug, info, warn, error

# Performance monitoring
NEXT_PUBLIC_MONITOR_RESPONSE_TIMES=true
NEXT_PUBLIC_ALERT_ON_SLOW_TRANSLATIONS=true
NEXT_PUBLIC_SLOW_TRANSLATION_THRESHOLD_MS=5000

# ============================================
# SAFETY & COMPLIANCE
# ============================================

# Content filtering
NEXT_PUBLIC_FILTER_SENSITIVE_CONTENT=true
NEXT_PUBLIC_SKIP_URLS_IN_TRANSLATION=true
NEXT_PUBLIC_SKIP_EMAILS_IN_TRANSLATION=true

# Privacy settings
NEXT_PUBLIC_ANONYMIZE_TRANSLATION_LOGS=true
NEXT_PUBLIC_RETENTION_DAYS=90

# Compliance
NEXT_PUBLIC_COMPLY_WITH_GDPR=true
NEXT_PUBLIC_COMPLY_WITH_CCPA=true

# ============================================
# DEBUG & DEVELOPMENT
# ============================================

# Debug mode
NEXT_PUBLIC_DEBUG_TRANSLATION=false
NEXT_PUBLIC_SHOW_TRANSLATION_INFO=false

# Mock services for development
NEXT_PUBLIC_USE_MOCK_TRANSLATION=false
NEXT_PUBLIC_MOCK_TRANSLATION_DELAY_MS=100

# Test mode
NEXT_PUBLIC_TEST_MODE=false
NEXT_PUBLIC_TEST_LANGUAGES=en,es

# ============================================
# WEBHOOKS & INTEGRATIONS
# ============================================

# Webhook for translation events
NEXT_PUBLIC_TRANSLATION_WEBHOOK_URL=

# Slack notifications for translation errors
NEXT_PUBLIC_SLACK_WEBHOOK_URL=

# Email notifications
NEXT_PUBLIC_EMAIL_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# ============================================
# NOTES
# ============================================

# 1. Start with one translation service (Google Translate recommended)
# 2. Enable caching to reduce API costs
# 3. Set appropriate rate limits based on your subscription
# 4. Monitor usage and costs regularly
# 5. Test with priority languages first before expanding

# For production:
# - Use environment-specific files (.env.production, .env.staging)
# - Store API keys in secure secret management
# - Enable monitoring and alerts
# - Regular cache cleanup
# - Backup translation configurations